    ) -> Response:
        if not database.delete_saved_view(principal.tenant_id, principal.actor_id, view_id):
            raise HTTPException(status_code=404, detail="Saved view not found")
        database.audit(
            principal.tenant_id,
            None,
            principal.actor_id,
            "saved_view.deleted",
            {"view_id": view_id},
