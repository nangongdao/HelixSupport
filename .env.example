# Local development. Production refuses to start with AUTH_MODE=demo.
APP_ENV=development
DATABASE_PATH=data/support.db
AUTH_MODE=demo
DEMO_API_KEY=helix-demo-key

# Production API-key map. Replace with a secret manager injection and long random keys.
# API_KEYS_JSON={"replace-with-at-least-32-random-characters":{"tenant_id":"tenant-a","actor_id":"ops.admin","role":"admin"}}
API_KEYS_JSON={}

RATE_LIMIT_PER_MINUTE=120
NORMAL_SLA_MINUTES=120
HIGH_SLA_MINUTES=15
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=300
TURN_WORKER_ENABLED=true
TURN_WORKER_CONCURRENCY=1
TURN_JOB_POLL_INTERVAL_MS=200
TURN_JOB_LEASE_SECONDS=300
TURN_JOB_MAX_ATTEMPTS=3
TURN_JOB_RETRY_BASE_SECONDS=2
TURN_JOB_RETENTION_DAYS=30
CLAIM_TTL_SECONDS=900
DATABASE_POOL_SIZE=4
DATABASE_BUSY_TIMEOUT_MS=5000
KNOWLEDGE_CACHE_TTL_SECONDS=30
DASHBOARD_CACHE_TTL_SECONDS=5
CACHE_MAX_ENTRIES=512
CORS_ORIGINS=
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Operator reply drafts in browser localStorage. Disable on shared devices / strict privacy.
LOCAL_DRAFTS_ENABLED=true
LOCAL_DRAFT_TTL_MINUTES=720

# Task queue: sqlite (default) or redis (for multi-instance)
QUEUE_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry: set endpoint to export traces via OTLP
ENABLE_TELEMETRY=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=helix-support

# OIDC/BFF session auth (optional, alongside API keys)
ENABLE_SESSION_AUTH=false
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
# OIDC_REDIRECT_URI=
# SESSION_SECRET=
# SESSION_TTL_MINUTES=480

# Optional semantic triage. Grounded knowledge answers remain deterministic.
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AUTO_ESCALATE_THRESHOLD=0.55

# Phase 19.2: fraction of turns routed to the registered canary prompt. 0 keeps
# the active version only; 1 sends every eligible turn to canary.
PROMPT_CANARY_RATIO=0.0

# Phase 20.5: worker cadence (seconds) for SLA-breach scans and outbound webhook
# delivery. Secrets for HTTP connectors and webhook endpoints stay in env/files.
WEBHOOK_DELIVERY_INTERVAL_SECONDS=30

# Customer Web Chat. The signing secret stays server-side. Frame ancestors is
# a comma-separated CSP origin allowlist; default is same-origin only.
WIDGET_SECRET=replace-with-a-long-random-secret
WIDGET_FRAME_ANCESTORS=self

# Phase 38 / formal inbound channel webhook. Prefer a gitignored mounted file
# in production; the JSON maps provider account ids to one tenant/channel and
# never accepts tenant identity from webhook payloads.
# CHANNEL_WEBHOOKS_JSON={"support-main":{"tenant_id":"demo","channel":"formal_chat","secret":"replace-with-at-least-32-random-bytes"}}
# CHANNEL_WEBHOOKS_FILE=data/secrets/channel-webhooks.json
CHANNEL_WEBHOOK_REPLAY_WINDOW_SECONDS=300
